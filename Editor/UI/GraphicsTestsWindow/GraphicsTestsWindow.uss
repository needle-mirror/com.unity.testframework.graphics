/* ── Tab content viewport ─────────────────────────────────── */

.unity-tab-view__content-viewport {
    height: 24px;
    flex-shrink: 0;
    overflow: visible;
}

/* ── Results tab ──────────────────────────────────────────── */

.results-tab {
    padding: 2px 0 0 0;
    flex-grow: 1;
}

.results-toolbar {
    flex-shrink: 0;
    flex-wrap: wrap;
    flex-grow: 0;
    flex-direction: row;
    overflow: visible;
    height: auto;
}

.results-toolbar__search {
    flex-grow: 1;
    flex-shrink: 0;
    width: auto;
}

.results-toolbar__buttons {
    flex-grow: 0;
    flex-direction: row;
    flex-shrink: 1;
    justify-content: flex-end;
}

/* ── Test list panel ──────────────────────────────────────── */

.test-list-panel {
    flex-grow: 1;
    flex-direction: column-reverse;
    justify-content: space-between;
    align-self: auto;
    align-content: stretch;
    flex-shrink: 1;
}

/* ── Comparison tabs ──────────────────────────────────────── */

.comparison-tabs {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-start;
    border-bottom-width: 1px;
    border-top-width: 0;
}

.new-comparison-button {
    flex-grow: 0;
    margin: 0;
    padding: 4px 0;
    border-right-width: 0;
    border-left-width: 0;
    width: 24px;
    height: 24px;
    font-size: 16px;
}

/* ── Test tree view ───────────────────────────────────────── */

.test-tree {
    -unity-text-align: lower-left;
    flex-direction: column;
    -unity-font-style: normal;
    flex-grow: 1;
    min-height: 200px;
}

/* ── Empty-state overlay ─────────────────────────────────── */

.empty-state-overlay {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    min-height: 200px;
}

.empty-state-overlay__label {
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.empty-state-overlay__hint {
    font-size: 12px;
    -unity-text-align: middle-center;
    opacity: 0.6;
    margin-bottom: 16px;
    max-width: 400px;
    white-space: normal;
}

.empty-state-overlay__button {
    padding: 6px 20px;
    font-size: 14px;
}

/* ── Image panel ──────────────────────────────────────────── */

.image-panel {
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: 100%;
    margin: 10px;
    display: none;
    justify-content: flex-start;
    align-items: stretch;
    align-self: auto;
    align-content: flex-end;
    flex-wrap: nowrap;
}

.image-group {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: nowrap;
    width: auto;
    position: relative;
    justify-content: space-between;
    margin: 0;
    padding: 0;
    flex-shrink: 1;
    flex-basis: 1200px;
    align-items: auto;
    align-content: flex-start;
}

/* ── Image masks ──────────────────────────────────────────── */

.image-masks {
    flex-grow: 1;
    flex-direction: row;
    position: absolute;
    flex-shrink: 1;
    width: 100%;
    height: 100%;
}

.image-mask {
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-color: rgba(42, 42, 42, 0.5);
    border-right-color: rgba(42, 42, 42, 0.5);
    border-top-color: rgba(42, 42, 42, 0.5);
    border-bottom-color: rgba(42, 42, 42, 0.5);
    background-color: rgb(56, 56, 56);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
}

.image-mask--right {
    width: 100%;
    height: 100%;
    position: relative;
    flex-grow: 0;
    flex-shrink: 1;
    transform-origin: right;
}

.image-mask--left {
    width: 50%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    flex-grow: 1;
    flex-shrink: 0;
    transform-origin: left;
}

/* ── Comparison images ────────────────────────────────────── */

.comparison-image {
    display: flex;
    min-width: 100%;
    min-height: auto;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    flex-grow: 1;
    background-size: cover;
}

.overlay-image {
    overflow: hidden;
    visibility: hidden;
}

/* ── No-image placeholders ────────────────────────────────── */

.no-image-bg {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: center;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(200, 200, 200);
}

.no-image-placeholder {
    display: none;
}

.no-image-label {
    flex-grow: 0;
    transform-origin: center;
    -unity-text-align: middle-center;
    font-size: 24px;
}

/* ── Image toolbar ────────────────────────────────────────── */

.image-toolbar {
    flex-grow: 0;
    height: auto;
    align-items: stretch;
    flex-wrap: nowrap;
    flex-shrink: 1;
    display: none;
    flex-direction: column;
    width: initial;
    position: absolute;
    right: 0;
    top: 0;
    padding: 1px;
    border-width: 0;
}

.toolbar-button--borderless {
    border-width: 0;
}

.toolbar-spacer {
    height: 6px;
}

.toolbar-separator {
    height: 6px;
    border-width: 0;
    width: 100%;
}

/* ── Variant navigator ────────────────────────────────────── */

.variant-navigator {
    flex-grow: 0;
    flex-direction: row;
    border-width: 0;
}

.variant-nav-button {
    border-width: 0;
    width: 24px;
}

.variant-label {
    flex-grow: 1;
    -unity-text-align: middle-center;
    padding-left: 4px;
    padding-right: 4px;
    min-width: 80px;
}

/* ── Toggle styles ────────────────────────────────────────── */

.overlay-toggle {
    -unity-text-align: upper-center;
    border-width: 0;
}

/* ── Reveal bar ───────────────────────────────────────────── */

.reveal-bar {
    flex-grow: 1;
    height: auto;
    min-height: 45px;
    bottom: 0;
}

.reveal-slider {
    flex-grow: 1;
    margin: 0;
    flex-shrink: 0;
    max-height: 16px;
    width: auto;
}

.reference-actual-bar {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    flex-direction: row;
    overflow: hidden;
    flex-wrap: nowrap;
    width: auto;
    margin: 0;
    flex-shrink: 0;
    flex-basis: 10%;
    align-items: stretch;
    height: auto;
    min-height: auto;
}

.image-bar {
    overflow: hidden;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
}

.image-bar--reference {
    flex-grow: 0;
    width: 50%;
    flex-direction: row-reverse;
    flex-shrink: 0;
    padding-left: 0;
    padding-right: 5px;
}

.image-bar--actual {
    flex-shrink: 1;
    flex-grow: 0;
    min-height: auto;
    min-width: auto;
    width: 50%;
    flex-direction: row;
    padding-left: 5px;
    padding-right: 0;
}

.image-label {
    font-size: 15px;
    overflow: hidden;
}

.image-label--reference {
    flex-shrink: 1;
    min-width: 0;
    color: rgb(255, 191, 216);
}

.image-label--actual {
    color: rgb(143, 212, 250);
}

/* ── Zoom slider ──────────────────────────────────────────── */

.zoom-slider {
    position: absolute;
    flex-grow: 0;
    flex-basis: auto;
    height: 65%;
    width: 10px;
    visibility: hidden;
}

/* ── Settings tab ─────────────────────────────────────────── */

.settings-tab {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 10px;
}

.settings-field {
    flex-grow: 1;
    flex-direction: row;
}

.inspector-container {
    flex-grow: 1;
    flex-shrink: 0;
}

/* ── Logs tab ─────────────────────────────────────────────── */

.logs-tab {
    flex-shrink: 1;
    flex-grow: 1;
    padding: 0 4px;
}

.logs-toolbar {
    flex-direction: row;
    justify-content: flex-end;
    flex-wrap: wrap;
    flex-grow: 1;
    height: auto;
}

.log-list {
    white-space: pre-wrap;
}

/* ── Breadcrumbs (hidden by default) ──────────────────────── */

.breadcrumbs-container {
    flex-grow: 1;
    display: none;
}

.breadcrumbs {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
}

/* ── Grab cursor for image panning ────────────────────────── */

.grabbable {
    cursor: pan;
}

.grabbing {
    cursor: pan;
}
